# ============================================================================
# Trakto — variables d'environnement
# Copier ce fichier en .env.local (jamais commité) et remplir les valeurs.
# ============================================================================

# URL du projet Supabase.
# Dashboard Supabase > Project Settings > API > "Project URL".
# Exemple : https://abcdefghijk.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clé publique (anon) du projet Supabase. Elle est faite pour être exposée au
# navigateur : la sécurité repose sur les policies RLS, pas sur cette clé.
# Dashboard Supabase > Project Settings > API > "anon public".
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NOTE : il n'y a volontairement AUCUNE variable service_role ici.
# La service_role key ne doit jamais être utilisée dans le runtime de l'app
# ni dans le runtime agent (règle absolue du projet). Si un besoin ponctuel
# apparaît (script d'administration hors app), il se traite hors de ce dépôt.
